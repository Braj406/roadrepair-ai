# Copy this file to .env.local and fill in your values. .env.local is never committed.
# Leave both empty to run in demo mode (accounts saved in your browser only).

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The "Publishable key" (sb_publishable_...), or on older projects the "anon" key.
# Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
